TAG=latest
WEB_PORT=3001
ALLOWED_DOMAINS=localhost
PORTRAIT_GRPC_TOKEN=
PORTRAIT_GRPC_TIMEOUT_MS=60000

# Worker: ONNX first, local ISNet fallback, no external API by default.
ONNX_SEGMENTATION_ENABLED=true
ONNX_MODEL_DTYPE=fp32
ONNX_EXECUTION_PROVIDERS=CPUExecutionProvider
ONNX_MODEL_WARMUP=true
LOCAL_SEGMENTATION_ENABLED=true
LOCAL_SEGMENTATION_MODEL=isnet-general-use
AI_PROVIDERS_ORDER=
AI_TIMEOUT_SECONDS=60
AI_REMOVEBG_API_KEY=
AI_CLIPDROP_API_KEY=
MAX_DIMENSION_LIMIT=4096
ALPHA_FEATHER=0
JPEG_QUALITY=90
BEAUTY_STRENGTH=35
GRPC_MAX_MESSAGE_SIZE=67108864

# Leave as rembg-models for a Docker volume, or set an absolute server path
# (for example /srv/picture-studio/models) to upload ONNX files manually.
AI_MODELS_SOURCE=rembg-models
