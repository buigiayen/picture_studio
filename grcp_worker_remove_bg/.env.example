PORTRAIT_HOST=0.0.0.0
PORTRAIT_PORT=50051

# BiRefNet lite ONNX is the primary local background segmenter.
ONNX_SEGMENTATION_ENABLED=true
ONNX_MODEL_DTYPE=fp32
# Local default: ~/.cache/picture_studio/models (Docker sets /models).
ONNX_EXECUTION_PROVIDERS=CPUExecutionProvider
ONNX_MODEL_WARMUP=true

# ISNet is a local fallback. External providers are opt-in.
LOCAL_SEGMENTATION_ENABLED=true
LOCAL_SEGMENTATION_MODEL=isnet-general-use
AI_PROVIDERS_ORDER=
AI_REMOVEBG_API_KEY=
AI_CLIPDROP_API_KEY=

MAX_DIMENSION_LIMIT=4096
ALPHA_FEATHER=0
BEAUTY_STRENGTH=35
